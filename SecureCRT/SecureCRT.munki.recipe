<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest version of SecureCRT and imports it into Munki.

To download Apple Silicon use: "arm64" in the DOWNLOAD_ARCH variable and "arm64" in the SUPPORTED_ARCH variable
To download Intel use: "x64" in the DOWNLOAD_ARCH variable and "x86_64" in the SUPPORTED_ARCH variable</string>
    <key>Identifier</key>
    <string>com.github.tsparr-recipes.munki.SecureCRT</string>
    <key>Input</key>
    <dict>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>SUPPORTED_ARCH</key>
        <string>arm64</string>
        <key>pkginfo</key>
        <dict>
            <key>blocking_applications</key>
            <array>
                <string>SecureCRT.app</string>
            </array>
            <key>catalogs</key>
            <array>
                <string>testing</string>
            </array>
            <key>description</key>
            <string>SecureCRT is a rock-solid terminal emulator with the strong encryption, broad range of authentication options, and data tunneling capabilities that IT professionals require to simplify their daily tasks.</string>
            <key>developer</key>
            <string>VanDyke Software</string>
            <key>display_name</key>
            <string>SecureCRT</string>
            <key>name</key>
            <string>%NAME%</string>
            <key>supported_architectures</key>
            <array>
                <string>%SUPPORTED_ARCH%</string>
            </array>
            <key>unattended_install</key>
            <true/>
            <key>unattended_uninstall</key>
            <true/>
        </dict>
    </dict>
    <key>MinimumVersion</key>
    <string>1.1</string>
    <key>ParentRecipe</key>
    <string>com.github.tsparr-recipes.download.SecureCRT</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
        </dict>
    </array>
</dict>
</plist>
