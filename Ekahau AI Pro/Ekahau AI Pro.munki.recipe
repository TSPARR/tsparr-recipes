<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest unlicensed version of Ekahau AI Pro and imports to Munki.</string>
    <key>Identifier</key>
    <string>com.github.tsparr-recipes.munki.Ekahau AI Pro</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>EkahauAIPro</string>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>pkginfo</key>
        <dict>
            <key>blocking_applications</key>
            <array>
                <string>Ekahau AI Pro.app</string>
                <string>Ekahau Pro.app</string>
            </array>
            <key>catalogs</key>
            <array>
                <string>testing</string>
            </array>
            <key>description</key>
            <string>Industry standard tool for designing, analyzing, optimizing and troubleshooting WiFi Networks.</string>
            <key>developer</key>
            <string>Ekahau Inc</string>
            <key>display_name</key>
            <string>Ekahau AI Pro</string>
            <key>name</key>
            <string>%NAME%</string>
            <key>preinstall_script</key>
            <string>#!/bin/zsh --no-rcs

if [[ -d "/Applications/Ekahau Pro.app" ]]; then
    /bin/rm -rf "/Applications/Ekahau Pro.app"
fi
</string>
            <key>unattended_install</key>
            <true/>
            <key>unattended_uninstall</key>
            <true/>
        </dict>
    </dict>
    <key>MinimumVersion</key>
    <string>1.1</string>
    <key>ParentRecipe</key>
    <string>com.github.tsparr-recipes.pkg.Ekahau AI Pro</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pkg_path%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
        </dict>
    </array>
</dict>
</plist>
